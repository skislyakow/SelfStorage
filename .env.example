# Копия этого файла — `.env` на VPS (он в .gitignore, не коммитится).
# Локально необязателен: без .env почта уходит в консоль, DEBUG из окружения.

# Секрет приложения (на проде — уникальная длинная строка)
SECRET_KEY=change-me-in-production

# False на продакшене
DEBUG=False

# Через запятую, напр. selftorage.kislyakov.pro
ALLOWED_HOSTS=selftorage.kislyakov.pro

# Путь к sqlite на сервере, напр. /opt/selftorage/db.sqlite3
DB_PATH=/opt/selftorage/db.sqlite3

# Исходящая почта (на проде — SMTP; локально можно не задавать — будет console).
# REG.RU: SMTP-сервер mail.hosting.reg.ru, порт 465 (SSL/TLS, EMAIL_USE_SSL=True)
# либо 587 (STARTTLS, EMAIL_USE_TLS=True). У домена kislyakov.pro должны быть
# опубликованы SPF/DKIM/DMARC, иначе письма уйдут в спам.
# Корректный SPF для почты REG.RU: v=spf1 include:_spf.runity.ru ~all
# (именно _spf.runity.ru, а не spf.reg.ru — последний не существует).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=587
EMAIL_HOST_USER=<SMTP_USER>@kislyakov.pro
EMAIL_HOST_PASSWORD=<SMTP_PASSWORD>
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# FROM должен быть реальным авторизованным ящиком REG.RU (иначе релей 451).
DEFAULT_FROM_EMAIL=selfstorage@kislyakov.pro
