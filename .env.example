# Копия этого файла — `.env` на VPS (он в .gitignore, не коммитится).
# Локально необязателен: без .env почта уходит в консоль, DEBUG из окружения.

# Секрет приложения (на проде — уникальная длинная строка)
SECRET_KEY=change-me-in-production

# False на продакшене
DEBUG=False

# Через запятую, напр. selftorage.kislyakov.pro
ALLOWED_HOSTS=selftorage.kislyakov.pro

# Путь к sqlite на сервере, напр. /opt/selftorage/db.sqlite3
DB_PATH=/opt/selftorage/db.sqlite3

# Исходящая почта (на проде — SMTP; локально можно не задавать — будет console)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=mailuser@example.com
EMAIL_HOST_PASSWORD=mailpass
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@selftorage.kislyakov.pro
